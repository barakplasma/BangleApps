{
  "id": "hebrew_calendar",
  "name": "Hebrew Calendar",
  "shortName": "HebCal",
  "version": "0.09",
  "description": "Hebrew calendar clock: shows current Hebrew date and upcoming holidays with candle-lighting times. Computes events on-device using the My Location app for your coordinates.",
  "icon": "app.png",
  "allow_emulator": true,
  "tags": "clocks,tools",
  "dependencies": { "mylocation": "app", "sched": "app" },
  "supports": [
    "BANGLEJS",
    "BANGLEJS2"
  ],
  "type": "clock",
  "readme": "README.md",
  "storage": [
    {
      "name": "hebrew_calendar.app.js",
      "url": "app.js"
            "no_minify": true
    },
    {
      "name": "hebrew_calendar.img",
      "url": "app-icon.js",
      "evaluate": true
    },
    {
      "name": "hebrew_calendar.settings.js",
      "url": "settings.js"
    }
  ],
  "data": [
    {
      "name": "hebrew_calendar.json"
    }
  ]
}
